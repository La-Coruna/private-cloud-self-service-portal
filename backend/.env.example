APP_NAME=private-cloud-self-service-portal
APP_ENV=local

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portal_db
DB_USER=portal_user
DB_PASSWORD=db_pw

# Kubernetes config
# Local development uses a named kubeconfig context.
# In-cluster GKE deployment sets KUBE_CONTEXT to an empty string.
KUBE_CONTEXT=kind-portal-dev

# Public demo guardrails
DEMO_MODE=false
DEMO_MAX_PROJECTS=3
DEMO_MAX_REPLICAS=1
DEMO_ALLOWED_IMAGES=nginx:latest,httpd:alpine,nginx-not-exist-demo:latest
DEMO_NAMESPACE_PREFIX=demo-
